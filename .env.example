# 默认零配置即可运行：不填任何变量时，应用进入「本地演示模式」。
# 本地演示模式：账号只存在当前浏览器，数据也只存在当前浏览器，不联网。

# ---- 云端模式（Supabase Auth）----
# 两者同时填写才会启用云端登录。anon key（或新版 publishable key）是公开密钥，真正的权限由数据库 RLS 决定。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 强制本地模式（即使配置了 Supabase）：用于离线演示与开发
VITE_LOCAL_MODE=false

# ---- AI 代理（M3 阶段启用）----
# 浏览器只调用这个同源地址，模型密钥只存在于服务端。
# 本地开发示例：VITE_AI_PROXY_URL=http://localhost:8787/api/ai
VITE_AI_PROXY_URL=

# ---- 仅服务端使用，禁止以 VITE_ 前缀暴露到前端 ----
# ARK_API_KEY=
# ARK_MODEL_ENDPOINT=